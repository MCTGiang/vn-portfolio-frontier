# ==============================================================================
# vn-portfolio-frontier — Environment configuration template
# ==============================================================================
#
# Copy this file to `.env` and fill in your actual values.
# `.env` is git-ignored and MUST NOT be committed.
#
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# ------------------------------------------------------------------------------

# Neon Cloud PostgreSQL connection string
# Retrieve from: https://console.neon.tech/app/projects/<your-project>/settings
# Format:  postgresql://<user>:<password>@<host>/<db>?sslmode=require
NEON_DATABASE_URL="postgresql://portfolio_owner:npg_YOUR_PASSWORD@ep-XXX-XXX.ap-southeast-1.aws.neon.tech/portfolio?sslmode=require"

# Region (informational; must match Neon project region)
NEON_REGION="ap-southeast-1"

# Application environment: development | staging | production
APP_ENV="development"

# ------------------------------------------------------------------------------
# Data sources (Phase 2+ — uncomment when needed)
# ------------------------------------------------------------------------------

# VNSTOCK_API_KEY=""
# YFINANCE_ENABLED="true"

# ------------------------------------------------------------------------------
# NLP / model config (Phase 6 — uncomment when needed)
# ------------------------------------------------------------------------------

# HUGGINGFACE_TOKEN=""
# PHOBERT_MODEL_PATH="vinai/phobert-base-v2"
